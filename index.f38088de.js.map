"use strict";
// write code here
var theads = document.querySelectorAll("th");
var tbody = document.querySelector("tbody");
function parceMoney(value) {
    return Number(value.replaceAll("$", "").replaceAll(",", ""));
}
theads.forEach(function(thead, headerIndex) {
    thead.addEventListener("click", function() {
        var rowsArray = Array.from(tbody.querySelectorAll("tr"));
        rowsArray.sort(function(rowA, rowB) {
            var cellA = rowA.cells[headerIndex].textContent.trim();
            var cellB = rowB.cells[headerIndex].textContent.trim();
            if (parceMoney(cellA)) return parceMoney(cellA) - parceMoney(cellB);
            return cellA.localeCompare(cellB, "uk");
        });
        rowsArray.forEach(function(row) {
            return tbody.appendChild(row);
        });
    });
});

